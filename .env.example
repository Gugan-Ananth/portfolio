# Canonical site origin for metadataBase, sitemap, OG, and absolute URLs.
# No trailing slash. Server-side only — read via getSiteUrl() in lib/site-url.ts.
#
# Local development default:
SITE_URL=http://localhost:3000
#
# Production (set on Vercel / host; required before public launch):
# SITE_URL=https://your-domain.com
